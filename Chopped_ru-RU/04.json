    "GenericHeister_ID_jupiter_m4_cough_1_All_1": "Кха, кха...",
    "GenericHeister_ID_jupiter_m1_start2_1_All_1": "Сука... началось.",
    "GenericHeister_ID_jupiter_m2_dad_2_All_1": "ПАПА!",
    "GenericHeister_ID_jupiter_m3_panic_1_All_1": "ПАПА!",
    "GenericHeister_ID_jupiter_m3_dad_1_All_1": "ПАПА!",
    "GenericHeister_ID_jupiter_m3_dad3_1_All_1": "Папа... мой папочка...",
    "GenericHeister_ID_jupiter_m4_monkey_1_All_1": "СДОХНИ, ПЕС ВОНЮЧИЙ! СДОХНИ!",
