  "ST_jupiter_Variations": {
    "GenericHeister_ID_jupiter_m4_three_1_All_1": "3... ищем дальше.",
    "GenericHeister_ID_jupiter_m4_warm_1_All_1": "Я УГАДАЛА, ЧМОШНИК?",
    "GenericHeister_ID_jupiter_m1_list2_1_All_1": "Гребаный список... вот... забирай.",
    "StoryCharacter3D_ID_jupiter_m2_blackscreen5_2_All_1": "Вот дерьмо. Проблемы!",
    "StoryCharacter3D_ID_jupiter_m1_beaten_1_All_1": "Ох, слабоват я.",
    "StoryCharacter3D_ID_jupiter_m1_win2_1_All_1": "Ух... забери список!",
    "StoryCharacter3D_ID_jupiter_m1_hit3_1_All_1": "Ух, да какого хера?!",
    "StoryCharacter3D_ID_jupiter_m1_clients_1_All_1": "Ага! Вот он!",
    "GenericHeister_ID_jupiter_m4_up_1_All_1": "Ага... лестница... спорю, ты наверху...",
    "StoryCharacter3D_ID_jupiter_m1_deal4_1_All_1": "Нам нужен только он. Отдай нам список, и всё это закончится.",
    "GenericHeister_ID_jupiter_m2_stairs_1_All_1": "О-о-о-о, гребаный день ног.",
    "GenericHeister_ID_jupiter_m3_pain_1_All_1": "Ах-х-х!",
    "GenericHeister_ID_jupiter_m2_blackscreen_1_All_1": "А-а-а... Дерьмо....",
    "StoryCharacter3D_ID_jupiter_m3_blackscreen_2_All_1": "Всё в твоей сумке, в шкафчике.",
    "StoryCharacter3D_ID_jupiter_m5_swat_1_All_1": "Всему составу оставаться на местах. Спецназ в пути! Повторяю: спецназ в пути.",
    "GenericHeister_ID_jupiter_m3_all_die_1_All_1": "Все умрут... Все...умрут...",
    "GenericHeister_ID_jupiter_m4_all_die_1_All_1": "Все... ум...рут.",
    "StoryCharacter3D_ID_jupiter_m5_blackscreen3_3_All_1": "И она пошла?",
    "GenericHeister_ID_jupiter_m3_bag2_1_All_1": "Сумку, забери сумку!",
    "GenericHeister_ID_jupiter_m3_bag5_1_All_1": "Сумка... сумка!",
    "GenericHeister_ID_jupiter_m3_bag_1_All_1": "Сумка... надо забрать сумку...",
    "StoryCharacter3D_ID_jupiter_m5_swat2_1_All_1": "Всем приготовиться. Спецназ уже на местах.",
    "StoryCharacter3D_ID_jupiter_m4_why_1_All_1": "Ты чё, сука, совсем берега попутала?!",
    "StoryCharacter3D_ID_jupiter_m1_beaten5_1_All_1": "Бум, сука! Давай сюда список!",
