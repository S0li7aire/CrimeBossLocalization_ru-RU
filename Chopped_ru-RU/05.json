  "ST_meta_StoryGoals": {
    "meta_story_99p_99problems_title": "...Но сука не одна",
    "meta_story_cag_cagnalisorder_title": "Новая угроза",
    "meta_story_dds_investigatezang_title": "Богатый гость",
    "meta_story_mtr_painandgain_description": "Головорезы Хьело решили порезвиться не в том районе. Назревает кровавая баня. Мы собираемся вернуть свое — и еще забрать немного сверх.",
    "meta_story_cag_cagnalisorder_description": "В городе появился новый ключевой игрок, и она шутить не привыкла. С помощью своих технологий и связей Канали намеревается захватить власть. Разумеется, мы не можем этого допустить.",
    "meta_story_ftd_wizhack_description": "Нужно показать диск настоящему профи. Один такой сейчас сидит за решеткой. Для нас это не помеха.",
    "meta_story_cup_goldrush_description": "Объединившись с Денежным Драконом, проверните ограбление века. Но прежде чем вы этим займетесь, вам кое-что понадобится.",
    "meta_story_mtr_armoredcash_title": "Непростые деньги",
    "meta_story_mtr_lambo_description": "Как говорится, хороший понт дороже денег. Кейси нашла способ это продемонстрировать — новейшая модель Торини.",
    "meta_story_dds_newblood_description": "Начинающие грабители, готовые ринуться в бой, попадают под крыло ветерана Тачдауна. ",
    "meta_story_coc_blackbliss_title": "Черное золото",
    "meta_story_coc_thecaviar_title": "Черное золото",
    "meta_story_99p_spayingthecagna_description": "Канали свихнулась. Ее территория растет, и Канали решила, что город принадлежит ей. Пора доказать, что она ошибается. Раз и навсегда.",
    "meta_story_cag_strikeback_description": "Канали заключила сделку с полицией и теперь стремительно захватывает городские территории. Серво и Тачдаун готовятся вернуть себе власть силой.",
    "meta_story_cag_strikeback_title": "Приказы Канали",
    "meta_story_coc_thecaviar_description": "Икра хороша, но власть и деньги — лучше. Нужно быстро сбагрить икру кому-нибудь.",
    "meta_story_ops_title": "Морозный удар",
    "meta_story_ops_winterops_title": "Морозный удар",
    "meta_story_dds_dragondogsheist_title": "Дракопсы",
    "meta_story_cup_thegoldcup_description": "Всё готово. Но возможно, стоит рассмотреть и другие варианты. Дополнительные предосторожности никогда не помешают, особенно когда дело настолько масштабное.",
    "meta_story_thv_twobanks_title": "Пятьдесят на пятьдесят",
    "meta_story_ftd_wizhack_title": "Освободить Виза",
    "meta_story_mtr_ringer_description": "Гловз намекнул, что один полицейский нуждается в наших услугах. Взамен он поможет нам в дельце с поездом.",
    "meta_story_cup_goldrush_title": "Золотая лихорадка",
    "meta_story_coc_killkhan_title": "С днем рождения, Хан",
    "meta_story_hie_killhielo_description": "Мак, бывший работник Хьело, попал в непростую ситуацию. Если поможем ему, он подскажет, как справиться с главным тусовщиком Рокая.",
    "meta_story_ime_importexport_primary_title": "Импорт-экспорт",
    "meta_story_coc_stealkhansshipment_description": "Пора заработать и одновременно ослабить Хана. Мы украдем его груз, легко и просто.",
    "meta_story_mtr_painandgain_title": "Сочный бриллиант",
    "meta_story_thv_thvshort_title": "Ключ без замка",
    "meta_story_coc_killkhan_description": "Хан слишком стар для этого города. Надо будет подогнать ему подарочек — незабываемый тур на тот свет.",
    "meta_story_cup_kingsrighthand_title": "Правая рука Короля",
    "meta_story_mtr_lambo_title": "Мечта матадора",
    "meta_story_dds_newblood_title": "Новая кровь",
    "meta_story_mtr_armoredcash_description": "Недавно зарегистрированные бронированные грузовики движутся через город. Давайте разобьем какую-нибудь из этих копилок на колесах и узнаем, куда они везут бабки!",
    "meta_story_ftd_wizdisc_description": "Только профессионал сможет расшифровать истинное содержимое диска. К счастью в тюряге есть один парень, который мечтает выбраться на свободу.",
    "meta_story_mtr_ringershort_description": "Наша цель — инкассаторский поезд, который отправляется из Рокая, до отказа набитый государственными деньгами. Знакомый Гловза может предоставить информацию о поезде, но не за просто так. ",
    "meta_story_mtr_moneytrain_description": "Наша цель — инкассаторский поезд, наполненный под завязку федеральными деньгами, он уходит из Рокая. Это хорошая возможность, хотя и опасная.",
    "meta_story_thv_onebank_title": "Копилка",
    "meta_story_mtr_ringer_title": "Тёмная лошадка",
    "meta_story_thv_thvshort_description": "Преступный мир Рокая охотится за таинственным диском, а это означает только одно: в деле замешаны большие деньги. Что бы ни было на этом диске, мы должны узнать об этом первыми.",
    "meta_story_99p_spayingthecagna_title": "Охолостить суку",
    "meta_story_ops_coldstrike_title": "Экстренная ситуация",
    "meta_story_ftd_findthedisc_title": "Диск",
    "meta_story_cup_thegoldcup_title": "Золотой кубок",
    "meta_story_thv_hiddenvault_title": "Скрытое хранилище",
    "meta_story_hie_killhielo_title": "Последняя песня",
    "meta_story_mtr_moneytrain_primary_title": "Инкассаторский поезд",
    "meta_story_dds_investigatezang_description": "Знаменитая семья Цзан прибывает в Рокай вместе со своими сокровищами. Нам бы не помешало раздобыть информацию о том, что привело их в город.",
    "meta_story_dds_dragondogsheist_description": "Легендарные и необычайно ценные дракопсы могут стать вашими, если всё пойдет по плану. За работу.",
    "meta_story_ftd_findthedisc_description": "По слухам, в городе появился диск с очень ценной информацией. Его нужно заполучить.",
    "meta_story_cup_kingsrighthand_description": "Тачдаун нашел золотую монету, которая, очевидно, является частью сокровищ из огромного золотохранилища, спрятанного где-то в городе. Новость стоит того, чтобы уделить ей время.",
    "meta_story_mtr_moneytrain_title": "Ограбление поезда",
    "meta_story_mtr_ringershort_title": "Ограбление поезда",
    "meta_story_coc_stealkhansshipment_title": "Груз полководца",
    "meta_story_coc_blackbliss_description": "На прошлой работе мы потеряли несколько фишек, но мы всё еще за лучшим игральным столом. Давайте ограбим склад Хана с «черным золотом».",
    "meta_story_99p_99problems_description": "Сучка именно там, где нам нужно. Теперь она и ее оставшиеся прихвостни у нас землю жрать будут.",
    "meta_story_coc_khanssmugglingboat_title": "Что в лодке?",
    "meta_story_ftd_wizdisc_title": "Что на диске, Виз?",
    "meta_story_thv_onebank_description": "Виз взломал диск, и теперь мы знаем, где находится ТО САМОЕ скрытое хранилище. Видимо таки придется его ограбить.",
    "meta_story_thv_twobanks_description": "Виз добыл для нас код доступа к скрытому хранилищу. Оно может быть в одном из двух банков. Видимо, придется бросить монетку.",
    "meta_story_coc_khanssmugglingboat_description": "По городу ходят слухи, что Хан промышляет контрабандой. Стоит выяснить, что находится на его яхте. Может, у нас получится немного «облегчить его ношу».",
    "meta_story_ops_coldstrike_description": "Вы заработали серьезную репутацию в Рокае… и ваши подвиги наделали шума. И вот, с утра пораньше вам приходит интересное предложение от еще более интересного заказчика."
