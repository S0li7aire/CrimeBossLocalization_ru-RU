  "ST_mm_Missions": {
    "meta_mm_rob_highwayconvoy-beach_description": "Скоро здесь проедет несколько грузовиков под мощной охраной. Что они перевозят? Кто знает. Неважно: лучше получить что-то ненужное, чем остаться без чего-то нужного.",
    "meta_mm_rob_highwayconvoy-highway_description": "Скоро здесь проедет несколько грузовиков под мощной охраной. Что они перевозят? Кто знает. Неважно: лучше получить что-то ненужное, чем остаться без чего-то нужного.",
    "meta_mm_rob-business-restaurant-center-1_description": "Местный ресторан, кажется, предлагает любимым клиентам особые домашние пряности. Кто-то явно должен взять на себя ответственность и прикрыть лавочку, пока до них не дойдет, что такое безопасность пищевых продуктов.",
    "meta_mm_rob-business-warehouse-harbor_description": "Склад на отшибе, забитый всевозможными ценностями, да еще и упакованными словно специально для вас. Рождественский подарок, право слово.",
    "meta_mm_rob-robbery-center_description": "Старое доброе ограбление. Добираетесь до места, хватаете всё, что не привинчено, и сваливаете. Легкие деньги.",
    "meta_mm_atg-loothit-center_description": "Бойцы конкурентов встречаются в центре города. Заглянем туда и посмотрим, что они приготовили.",
    "meta_mm_rob-business-restaurant-center-2_description": "Скромный семейный ресторанчик, с дикими счетами за отопление в разгар лета. Стоит покопаться у них в подвале.",
    "meta_mm_rob-multistore-center_description": "Маленький торговый центр в тихом районе, где охрана работает за копейки. Да они просто напрашиваются.",
    "meta_mm_avh-crashedvan-center_description": "Устройте засаду и ограбьте бронированный грузовик. В них всегда есть что-то ценное.",
    "meta_mm_avh_crashedvan-harbor_description": "По городу катается копилка на колесах, которая только и ждет, как бы кто-нибудь ее разбил.",
    "meta_mm_avh-convoyblockedvan_title": "Бронированный конвой",
    "meta_mm_avh-convoyblockedvan-harbor_title": "Ограбление бронированного грузовика",
    "meta_mm_avh-cranevan-harbor_title": "Ограбление бронированного грузовика",
