    "meta_mm_avh_crashedvan-harbor_title": "Ограбление бронированного грузовика",
    "meta_mm_gal_artgallery-center_title": "Искусство ограблений",
    "meta_mm_auc_auctionhouse_title": "Аукционный зал",
    "meta_mm_bank_title": "Ограбление банка",
    "meta_mm_jewelry_description": "Большой заманчивый ювелирный магазин с кучей дорогих побрякушек, которые просто просят, чтобы их забрали.",
    "meta_mm_rob-robbery-night_description": "Вломитесь в охраняемое здание под покровом ночи. Заберите все ценности, какие найдете.",
    "meta_mm_rob-robbery-night_title": "Кража со взломом",
    "meta_mm_rob_cardealer-center_title": "Автосалон",
    "meta_mm_gangstercasetrade5_title": "Карта отклонена",
    "meta_mm_policecasetrade1_title": "Дело закрыто",
    "meta_mm_policecasetrade2_title": "Висяк",
    "meta_mm_atg-loothit_description": "В городе заметили пару гангстеров с ценными вещичками. Дайте им знать, что в этом городе ни одна мышь не должна пробежать без вашего одобрения.",
    "meta_mm_avh-crashedvan-highway_description": "Проникните внутрь попавшего в аварию грузовика и заберите всю наличку.",
    "meta_mm_gangstercasetrade1_title": "Неудачная сделка",
