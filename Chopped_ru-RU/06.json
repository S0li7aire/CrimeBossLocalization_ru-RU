  },
  "ST_svm_Variations": {
    "StoryCharacter3D_ID_svm_welcome_1_All_3": "Уф… Спасибо… Расписание Хьело в дальней комнате. Идемте, за мной.",
    "StoryCharacter3D_ID_svm_override_works_1_All_1": "Ага! Ха-ха-ха! Получилось! Я за проводок потянул, и панель зеленым загорелась… Плевать, короче. Погнали!",
    "StoryCharacter3D_ID_svm_swat_incoming_1_All_2": "Копы прибудут на шум с минуты на минуту. Давайте-ка не рассиживаться, ага?",
    "StoryCharacter3D_ID_svm_finish_enemies_1_All_1": "В общем, добивайте оставшихся и заходите.",
    "StoryCharacter3D_ID_svm_back_to_hack_1_All_3": "Так, панель заработала. Я запущу поезд. Вы, главное, меня прикрывайте!",
    "StoryCharacter3D_ID_svm_mac_sees_2_All_3": "Ага, нужно кое-чего из укрытия забрать, пошли.",
    "StoryCharacter3D_ID_svm_switch_confirm_1_All_7": "Всё, есть! Больше ничего не трогайте!",
    "StoryCharacter3D_ID_svm_mac_down_1_All_5": "Аргх!",
    "StoryCharacter3D_ID_svm_mac_dies_1_All_1": "Аргх! Ну всё, приехали.",
    "StoryCharacter3D_ID_svm_escape_reminder_1_All_6": "Эй! Все на борт!",
    "StoryCharacter3D_ID_svm_corridor_blocked_1_All_1": "Назад! Они заходят через коридор!",
    "StoryCharacter3D_ID_svm_escape_reminder_1_All_5": "Пошли уже!",
    "StoryCharacter3D_ID_svm_remove_saw_1_All_2": "Я не могу открыть ставни, пока там пила стоит.",
    "StoryCharacter3D_ID_svm_follow_mac_1_All_3": "Некогда тупить, нужно уходить!",
    "StoryCharacter3D_ID_svm_swat_here_1_All_1": "Проверьте боеприпасы. Как только дверь откроется, спецназ откроет пальбу.",
    "StoryCharacter3D_ID_svm_blackscreen_2_All_3": "Если чикосы меня заметят, то на месте и пришьют.",
    "StoryCharacter3D_ID_svm_get_back_1_All_2": "Возвращайтесь в диспетчерскую!",
    "StoryCharacter3D_ID_svm_escape_he_1_All_5": "Приходите за мной, как закончите!",
    "StoryCharacter3D_ID_svm_escape_reminder_1_All_2": "Вперед! Я хочу отсюда свалить!",
    "StoryCharacter3D_ID_svm_regroup_1_All_1": "Давайте, заходите.",
    "StoryCharacter3D_ID_svm_follow_mac_1_All_9": "Пошли, сюда!",
    "StoryCharacter3D_ID_svm_mac_shot_1_All_11": "Тут повсюду копы!",
    "StoryCharacter3D_ID_svm_control_1_All_2": "Копы временно отступили.",
    "StoryCharacter3D_ID_svm_wait_for_train_1_All_1": "Копы шутить не станут! Пора отсюда валить!",
    "StoryCharacter3D_ID_svm_control_room_briefing_1_All_1": "Прикройте меня! Сейчас я разберусь!",
    "StoryCharacter3D_ID_svm_mac_dies_1_All_5": "Сдох из-за хоум-видео! Какой позор.",
    "StoryCharacter3D_ID_svm_meet_reminder_1_All_3": "Вы что, не видите меня? Я довольно заметный.",
    "StoryCharacter3D_ID_svm_override_solution_1_All_5": "Ну что, есть эффект?",
    "StoryCharacter3D_ID_svm_escape_he_1_All_4": "Вы же каждый день мочите чикосов. Подумаешь, парочкой больше.",
    "StoryCharacter3D_ID_svm_control_1_All_1": "Пока удалось их отбросить.",
    "StoryCharacter3D_ID_svm_exit_blocked_1_All_2": "Входы перекрыли, там нам не выбраться!",
    "StoryCharacter3D_ID_svm_mac_down_1_All_18": "Могли бы уже мне помочь!",
    "StoryCharacter3D_ID_svm_welcome_1_All_1": "Идем в дальнюю комнату. У меня там вся инфа по концерту Хьело: график, расписание шоу. Всё как обещал.",
    "StoryCharacter3D_ID_svm_follow_mac_1_All_8": "За мной!",
    "StoryCharacter3D_ID_svm_prepare_3_All_1": "А там видно будет.",
    "StoryCharacter3D_ID_svm_override_works_1_All_5": "Да я просто жал на всё подряд. Надеюсь, всё-таки выберемся.",
    "StoryCharacter3D_ID_svm_mac_down_1_All_1": "Сука! А-а-а, в меня попали!",
    "StoryCharacter3D_ID_svm_chicos_1_All_4": "Блядь! Ёбаные чикосы, ёбаный Хьело!",
    "StoryCharacter3D_ID_svm_mac_dies_1_All_2": "Чёрт! Это всё…",
    "StoryCharacter3D_ID_svm_high_force_1_All_1": "Бля, бля, бля! Они уже дверь открыли!",
    "StoryCharacter3D_ID_svm_boarding_1_All_3": "Сука, вот это опасно было! Но дальше будет еще жестче. Хорошо, что я с вами туда уже не пойду.",
    "StoryCharacter3D_ID_svm_chicos_1_All_2": "Блядь. Они здесь!",
    "StoryCharacter3D_ID_svm_welcome_1_All_2": "Сраные чикосы. Ладно, идемте. Инфа по Хьело у меня в дальней комнате лавочки. И еще кое-что полезное там лежит.",
    "StoryCharacter3D_ID_svm_swat_reply_1_All_3": "Сраные мусора!",
    "StoryCharacter3D_ID_svm_get_back_1_All_1": "Давайте сюда!",
    "StoryCharacter3D_ID_svm_regroup_1_All_3": "Проходите.",
    "StoryCharacter3D_ID_svm_search_reminder_1_All_5": "Вытащите меня, и я вам заплачу авансом!",
    "StoryCharacter3D_ID_svm_escape_reminder_1_All_3": "Давайте на поезд!",
    "StoryCharacter3D_ID_svm_mac_shot_1_All_10": "Давайте сюда, помогайте!",
    "StoryCharacter3D_ID_svm_high_force_1_All_3": "Давайте сюда! Они уже заходят!",
    "StoryCharacter3D_ID_svm_assault_1_All_6": "Внимание! Копы уже здесь!",
    "StoryCharacter3D_ID_svm_speech_1_All_1": "Забирайте документы и помогите мне перетащить налик. Когда я свалил от Хьело, то забрал себе бонус, и я скорее его спалю, чем отдам ему обратно. Вы, разумеется, свою долю получите.",
    "StoryCharacter3D_ID_svm_remove_saw_1_All_1": "Пилу с дверей снимите.",
    "StoryCharacter3D_ID_svm_escape_reminder_1_All_4": "Залезайте уже на поезд!",
    "StoryCharacter3D_ID_svm_mac_shot_1_All_7": "Нас окружают!",
    "StoryCharacter3D_ID_svm_switch_objective_1_All_2": "Вот блин! Цепочку замкнуло! Найдите приборные щитки!",
    "StoryCharacter3D_ID_svm_corridor_blocked_1_All_3": "Вот блин! Тут мы вряд ли пробьемся!",
    "StoryCharacter3D_ID_svm_swat_reply_1_All_2": "Вот чёрт! Они повсюду!",
    "StoryCharacter3D_ID_svm_chicos_1_All_5": "Твою-то мать! Они уже здесь!",
    "StoryCharacter3D_ID_svm_switch_switched_1_All_5": "Очень хорошо!",
    "StoryCharacter3D_ID_svm_back_to_hack_1_All_1": "Очень хорошо! Прикройте меня, дайте дело закончить.",
    "StoryCharacter3D_ID_svm_switch_switched_1_All_3": "Питание частично появилось!",
    "StoryCharacter3D_ID_svm_follow_mac_1_All_11": "Не останавливаемся!",
    "StoryCharacter3D_ID_svm_control_room_3_All_1": "Значит, будем импровизировать.",
    "StoryCharacter3D_ID_svm_boarding_1_All_2": "Ха-ха! Получилось! Теперь нужно забрать мою кассету и хренову тучу бабла у Хьело.",
    "StoryCharacter3D_ID_svm_mac_shot_1_All_8": "Помогите, а то мне тут пизда придет!",
    "StoryCharacter3D_ID_svm_high_force_1_All_2": "Помогите! Они ж меня убьют!",
    "StoryCharacter3D_ID_svm_assault_1_All_1": "Копы на подходе!",
    "StoryCharacter3D_ID_svm_assault_1_All_4": "Это спецназ!",
    "StoryCharacter3D_ID_svm_switch_confirm_1_All_6": "Начали!",
    "StoryCharacter3D_ID_svm_help_saw_1_All_3": "Эй, ребята! Нам там дверь пилят. Разберитесь, а?",
    "StoryCharacter3D_ID_svm_help_serious_1_All_1": "Там замок совсем не алмазный! Давайте порезче!",
    "StoryCharacter3D_ID_svm_help_saw_1_All_1": "Эти уёбки пытаются выпилить дверь!",
    "StoryCharacter3D_ID_svm_mac_shot_1_All_4": "Эй! Мне копы сейчас башку продырявят. Как насчет помочь?",
    "StoryCharacter3D_ID_svm_escape_he_1_All_3": "Эй! Не бросайте меня! Мы же договорились!",
    "StoryCharacter3D_ID_svm_speech_1_All_4": "Вон вся инфа по Хьело. Пушки можете забирать, а если поможете мне наличку отсюда вытащить, я с вами поделюсь.",
    "StoryCharacter3D_ID_svm_speech_4_All_1": "Вон вся инфа по Хьело. Пушки можете забирать, а если поможете мне наличку отсюда вытащить, я с вами поделюсь.",
    "StoryCharacter3D_ID_svm_override_solution_1_All_2": "Ну-ка! Дайте-ка попробовать!",
    "StoryCharacter3D_ID_svm_override_solution_1_All_3": "Так, минуточку!",
    "StoryCharacter3D_ID_svm_boarding_1_All_4": "Надеюсь, вы всё необходимое забрали из укрытия! Что осталось, то уже не вернуть!",
    "StoryCharacter3D_ID_svm_countdown_half_1_All_2": "Быстрее, давайте на поезд!",
    "StoryCharacter3D_ID_svm_mac_shot_1_All_2": "Меня прижали!",
    "StoryCharacter3D_ID_svm_control_room_1_All_1": "Я без понятия, как управлять поездами. Есть идеи получше? Я весь внимание.",
    "StoryCharacter3D_ID_svm_override_works_1_All_2": "Не знаю, что я сделал, но как будто теперь работает. Погнали отсюда!",
    "StoryCharacter3D_ID_svm_override_start_1_All_2": "Я без понятия, что это за херь.",
    "StoryCharacter3D_ID_svm_low_force_1_All_3": "Очень сомневаюсь.",
    "StoryCharacter3D_ID_svm_get_back_1_All_3": "Прикройте! Давайте сюда!",
    "StoryCharacter3D_ID_svm_mac_shot_1_All_5": "На помощь!",
    "StoryCharacter3D_ID_svm_control_room_briefing_1_All_3": "Не подпускайте копов, дайте разобраться.",
    "StoryCharacter3D_ID_svm_swat_here_1_All_3": "Вижу спецназ на камерах. Сука, они там по всей платформе. Вряд ли намерены кого-то брать живьем.",
    "StoryCharacter3D_ID_svm_mac_down_1_All_14": "Так я долго не продержусь!",
    "StoryCharacter3D_ID_svm_escape_he_1_All_2": "Если меня грохнут, до Хьело вам точно не добраться! Я вам нужен!",
    "StoryCharacter3D_ID_svm_speech_1_All_2": "Инфа по Хьело на стене висит. И да, сделайте одолжение, помогите вынести отсюда бабос. Я заплачу, само собой!",
    "StoryCharacter3D_ID_svm_speech_2_All_1": "Инфа по Хьело на стене висит. И да, сделайте одолжение, помогите вынести отсюда бабос. Я заплачу, само собой!",
    "StoryCharacter3D_ID_svm_mac_sees_1_All_2": "Это вы на той стороне улицы?",
    "StoryCharacter3D_ID_svm_stop_saw_1_All_1": "Остановились! Это вы там, да? Слава яйцам.",
    "StoryCharacter3D_ID_svm_blackscreen_1_All_1": "Это Мак, я вас жду напротив станции.",
    "StoryCharacter3D_ID_svm_follow_mac_1_All_10": "Нам сюда!",
    "StoryCharacter3D_ID_svm_follow_mac_1_All_12": "Нам сюда, пошли.",
    "StoryCharacter3D_ID_svm_search_reminder_1_All_8": "Вытащите меня уже. На помощь!",
    "StoryCharacter3D_ID_svm_locked_he_1_All_1": "Я буду в укрытии. Разберитесь с ними!",
    "StoryCharacter3D_ID_svm_blackscreen_2_All_2": "Я вас проведу в укрытие. Там вся инфа по Хьело.",
    "StoryCharacter3D_ID_svm_mac_down_1_All_19": "Я кровью истекаю!",
    "StoryCharacter3D_ID_svm_mac_down_1_All_20": "Меня сейчас размажут!",
    "StoryCharacter3D_ID_svm_mac_down_1_All_4": "Я же сдохну. Я сдохну, да?",
    "StoryCharacter3D_ID_svm_locked_he_1_All_2": "Пока я цел, но мудил этих нужно пришить поскорее!",
    "StoryCharacter3D_ID_svm_mac_down_1_All_6": "В меня попали!",
    "StoryCharacter3D_ID_svm_mac_down_1_All_10": "Как же больно!",
    "StoryCharacter3D_ID_svm_search_reminder_1_All_2": "Я в магазе, у которого ставни на двери! Вытащите меня отсюда!",
    "StoryCharacter3D_ID_svm_locked_he_1_All_4": "Я не открою дверь, пока вы не перебьете этих уродов!",
    "StoryCharacter3D_ID_svm_stat_gangambush_1_All_2": "Я никуда не пойду, пока они не сдохнут!",
    "StoryCharacter3D_ID_svm_mac_down_1_All_8": "Меня подстрелили!",
    "StoryCharacter3D_ID_svm_search_reminder_1_All_6": "Я вас жду! Вы там скоро?",
    "StoryCharacter3D_ID_svm_search_reminder_1_All_3": "Я жду! Вы там скоро?",
    "StoryCharacter3D_ID_svm_get_back_reminder_1_All_1": "Жду вас в диспетчерской! Шевелите булками!",
    "StoryCharacter3D_ID_svm_mac_down_1_All_7": "Так, царапина!",
    "StoryCharacter3D_ID_svm_stat_gangambush_1_All_3": "Убейте их, пока они не грохнули меня!",
    "StoryCharacter3D_ID_svm_beat_thugs_1_All_3": "Нужно их убить, чтобы свалить отсюда.",
    "StoryCharacter3D_ID_svm_locked_he_1_All_3": "Убейте их, ага?",
    "StoryCharacter3D_ID_svm_mac_sees_2_All_1": "Давайте убираться отсюда.",
    "StoryCharacter3D_ID_svm_control_1_All_3": "Давайте за дело, пока копы не вернулись.",
    "StoryCharacter3D_ID_svm_follow_mac_1_All_6": "Нужно быстрее уходить!",
    "StoryCharacter3D_ID_svm_regroup_1_All_2": "Зайдем внутрь.",
    "StoryCharacter3D_ID_svm_follow_mac_1_All_2": "Давайте, ходу!",
    "StoryCharacter3D_ID_svm_follow_mac_1_All_1": "Пошли!",
    "StoryCharacter3D_ID_svm_follow_mac_1_All_7": "Некогда тут валандаться!",
    "StoryCharacter3D_ID_svm_follow_mac_1_All_4": "Живее, давайте!",
    "StoryCharacter3D_ID_svm_blackscreen_2_All_1": "Буду рад познакомиться лично.",
    "StoryCharacter3D_ID_svm_remove_saw_1_All_3": "Уберите пилу, и я вам открою.",
    "StoryCharacter3D_ID_svm_follow_mac_1_All_5": "Пошли, давай!",
    "StoryCharacter3D_ID_svm_override_nogood_1_All_4": "Плохо! Придется нам искать другой выход!",
    "StoryCharacter3D_ID_svm_switch_objective_1_All_4": "Нет, нет, нет! Контур замкнуло, питания нет! Дерните рубильник!",
    "StoryCharacter3D_ID_svm_override_start_1_All_1": "Эти кнопки вообще не пашут! Ничего не происходит!",
    "StoryCharacter3D_ID_svm_speech_1_All_3": "Неплохо, а? Пушки со стены можно забирать, и не забудьте документы по Хьело. А если поможете вынести бабло, я вам еще и бонус выдам.",
    "StoryCharacter3D_ID_svm_speech_3_All_1": "Неплохо, а? Пушки со стены можно забирать, и не забудьте документы по Хьело. А если поможете вынести бабло, я вам еще и бонус выдам.",
    "StoryCharacter3D_ID_svm_get_back_1_All_4": "Давайте обратно, в диспетчерскую!",
    "StoryCharacter3D_ID_svm_mac_sees_2_All_2": "Ладно, пошли. Не хочу тут торчать ни минуты сверх необходимого.",
    "StoryCharacter3D_ID_svm_stat_gangambush_1_All_1": "Ну так завалите их!",
    "StoryCharacter3D_ID_svm_mac_down_1_All_3": "Блядь! В меня попали!",
    "StoryCharacter3D_ID_svm_mac_sees_1_All_1": "Ага, вот вы где. Ну привет! Всего на полчаса опоздали. Что, с ограблений на «ролексы» не накопили?",
    "StoryCharacter3D_ID_svm_switch_switched_1_All_4": "Ага, уже что-то!",
    "StoryCharacter3D_ID_svm_override_works_1_All_4": "Ну, скрестим пальчики. Погнали!",
    "StoryCharacter3D_ID_svm_escape_station_1_All_1": "О-о-о-о... Так. Так. Всё. Похер! Погнали!",
    "StoryCharacter3D_ID_svm_mac_down_1_All_11": "Ай! Сука!",
    "StoryCharacter3D_ID_svm_mac_down_1_All_17": "Ай! Блин, плохо дело…",
    "StoryCharacter3D_ID_svm_finish_enemies_1_All_3": "Добивайте выживших! Я не открою, пока все чикосы не сдохнут.",
    "StoryCharacter3D_ID_svm_mac_down_1_All_16": "Эй! Не дайте им меня вальнуть!",
    "StoryCharacter3D_ID_svm_escape_station_1_All_3": "Только не бросайте меня, ага? Я не хочу сдохнуть в метро!",
    "StoryCharacter3D_ID_svm_switch_confirm_1_All_1": "Питание восстановлено!",
    "StoryCharacter3D_ID_svm_control_room_2_All_1": "Нет идей? Понятно.",
    "StoryCharacter3D_ID_svm_switch_confirm_1_All_5": "Готово! Есть питание!",
    "StoryCharacter3D_ID_svm_wait_for_train_1_All_2": "Спецназ так и будет прибывать! Надо уходить!",
    "StoryCharacter3D_ID_svm_exit_blocked_1_All_3": "Спецназ окружил станцию, нас прижали!",
    "StoryCharacter3D_ID_svm_control_1_All_4": "Спецназ отступает, но это ненадолго.",
    "StoryCharacter3D_ID_svm_mac_shot_1_All_12": "В меня целит спецназ!",
    "StoryCharacter3D_ID_svm_swat_incoming_1_All_1": "Спецназ уже где-то рядом. Пошли.",
    "StoryCharacter3D_ID_svm_assault_1_All_2": "Спецназ уже тут!",
    "StoryCharacter3D_ID_svm_assault_1_All_8": "Спецназ заходит!",
    "StoryCharacter3D_ID_svm_switch_switched_1_All_2": "Часть панели зажглась!",
    "StoryCharacter3D_ID_svm_mac_dies_1_All_6": "Увидимся в аду…",
    "StoryCharacter3D_ID_svm_switch_objective_1_All_1": "Чёрт! Размыкатель вырубило! Найдите щитки и восстановите питание панели!",
    "StoryCharacter3D_ID_svm_corridor_blocked_1_All_2": "Чёрт! Тут нам не выйти!",
    "StoryCharacter3D_ID_svm_mac_down_1_All_2": "Чёрт, чёрт! Сука, как же больно!",
    "StoryCharacter3D_ID_svm_beat_thugs_1_All_1": "Валите их!",
    "StoryCharacter3D_ID_svm_mac_dies_1_All_4": "Нужно было… звонить… Хану…",
    "StoryCharacter3D_ID_svm_help_saw_1_All_2": "Сукины дети, они выпиливают проход!",
    "StoryCharacter3D_ID_svm_mac_down_1_All_12": "Вот чёрт, больно как!",
    "StoryCharacter3D_ID_svm_finish_enemies_1_All_2": "Похоже, вы почти всех разнесли. Добейте выживших, и я открою ставни.",
