  "ST_start_Variations": {
    "GenericBoss_ID_start_devil_wtf_1_All_1": " Иисусе, Кейси, какого хера?",
    "GenericBoss_ID_start_captainSpeak2_1_All_1": " Охренеть, серьезная огневая мощь!",
    "GenericNPC_ID_start_devil_ronin_1_All_1": " Пора... нам пора!",
    "GenericBoss_ID_start_captainMeet_2_All_1": " Предположу, что палит в основном Тачдаун.",
    "GenericBoss_ID_start_burnMoney_1_All_1": " Насара! Банк затянуло дымом, и целая куча бабла сгорит на хрен!",
    "GenericBoss_ID_start_captainReinforcements_1_All_1": "Хватит об этом, у нас гости...",
