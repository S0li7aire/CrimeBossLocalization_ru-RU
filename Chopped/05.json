  "ST_meta_IntroGoals": {
    "meta_goal_intro_candyman_title": "Candyman",
    "meta_goal_intro_whiskeywholesale_description": "Cash isn't just in jewelry and narcotics. There's a shitload of it in antiquated liquor and we've already got several tips where to get to it.",
    "meta_goal_intro_firstarmoredvan_title": "First Armored Truck",
    "meta_goal_intro_firstbank_title": "First Bank",
    "meta_goal_intro_firstday_title": "First Day",
    "meta_goal_intro_firststore_title": "First Store",
    "meta_goal_intro_turfwar_description": "If you're about to swim with the sharks, you'll need territories. And your old friend Touchdown might be the perfect person to help you with that.",
    "meta_goal_intro_managementlesson_title": "Management Lesson",
    "meta_goal_bes_nasarawoes_description": "More and more, Nasara's thoughts have been wandering back to the fateful night before he met Baker, when he found himself on the brink of death, struck from the shadows.",
    "meta_goal_bes_nasarawoes_title": "Nasara's Woes",
    "meta_goal_intro_turfwar_title": "Start the Turfwar",
    "meta_goal_intro_firstday_description": "The life of a budding crime boss is not easy, and the time to learn the ropes is running short. The city doesn�t forgive mistakes.",
    "meta_goal_intro_firstbank_description": "There is a bank we could attempt to rob. It's well-guarded, but the earnings could be substantial.",
    "meta_goal_intro_managementlesson_description": "There is no point in amassing wealth if you can't make it grow. I can show you how to achieve just that.",
    "meta_goal_intro_firststore_description": "This jewelry store right here should have loads of valuables stashed inside and it�s quite low risk for us.",
    "meta_goal_intro_firstarmoredvan_description": "We track the movement of an armored truck filled to the brim with valuables. The ambush is prepared, as soon as you want to call it.",
    "meta_goal_intro_whiskeywholesale_title": "Whiskey Wholesale",
    "meta_goal_intro_candyman_description": "You've surrounded yourself with competent people and have a solid base of operations. Time to expand your candy business across Rockay City!"
  },
