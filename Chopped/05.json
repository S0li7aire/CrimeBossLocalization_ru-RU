    "meta_mm_loothit-harbor_alcohol_title": "Return to Sender",
    "meta_mm_loothit-highway_diamonds_description": "Rival gangsters took the job we wanted. So now they will bear the brunt of our bullets.",
    "meta_mm_security-harbor_drugs_title": "Rivalry",
    "meta_mm_armoredvan-cranevan_objective": "Rob an armored truck",
