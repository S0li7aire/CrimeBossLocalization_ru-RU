    "meta_gang_khan_gang_description": "Riders description",
    "meta_gang_cagnali_gang_title": "Scudos",
    "meta_gang_cagnali_gang_description": "Scudos description",
    "meta_partner_secretary_title": "Secretary",
    "meta_tutorial_office_stash-sliders": "Select how much you want to sell and hit the button. Be conservative � loot can sometimes be used for a purpose other than fast cash.",
    "meta_gang_sheriff_boss_title": "Sheriff",
    "meta_gang_sheriff_boss_description": "Sheriff Norris is out to dismantle gangs like ours. Back to back jobs will raise the heat but lie low for a�day and the cops will cool off.\r\nHowever, his investigation will persist and once its complete, well� game over.",
    "meta_gang_dollardragon_gang_title": "Sicarios",
    "meta_gang_dollardragon_gang_description": "Sicarios description",
    "meta_tutorial_hirearmy_resting": "Soldiers sent to capture turfs or to partake in other activities will not be available until the next day.",
