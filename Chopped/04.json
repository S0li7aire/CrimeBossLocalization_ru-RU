  "ST_meta_AssetGoasl": {
    "meta_assets_snatch_snatcher_description": "A new, promising technology startup is looking for investors. For a portion of the newfound company�s shares, we can help the business to kick off. \r\nThe only problem is that our investment needs to be backed by a substantial sum of gold.",
    "meta_assets_antiques_painting_description": "An art collector promises to introduce you to the world of antique collectables if you can help him obtain a renowned art piece.",
    "meta_assets_antiques_sabre_description": "An eighteenth-century French sabre surfaced in the city. Napoleon Bonaparte bestowed it upon a soldier who proved his valor in combat.",
    "meta_assets_antiques_cannon_title": "Antique Cannon",
    "meta_assets_antiques_musket_title": "Antique Musket",
    "meta_assets_antiques_painting_title": "Antique Painting",
    "meta_assets_antiques_sabre_title": "Antique Sabre",
    "meta_assets_pent_penthouse_description": "As you're expanding your empire across the city center, which has been torn apart by the turf war, Casey sees this as an opportunity to pour some cash into a penthouse that has noticeably depreciated in value.",
    "meta_assets_lambo_thelambo_description": "Casey can get you new set of wheels, the latest Torini. Make it yours by any means necessary, and make everyone jealous!",
    "meta_assets_antiques_musket_description": "Casey received news about a rare flintlock musket that once commissioned by Louis XIV for his generals.",
    "meta_assets_concrete_cementingthedeal_title": "Cementing the Deal",
    "meta_assets_concrete_concretematters_title": "Concrete Matters",
    "meta_assets_lambo_thelambo_title": "Luxury Horsepower",
    "meta_assets_piano_title": "Melody of Heavens",
    "meta_assets_pent_penthouse_title": "Real Estate",
    "meta_assets_snatch_snatcher_title": "Snatcher",
    "meta_assets_snatch_snatchershares_title": "Snatcher Shares",
    "meta_assets_snatch_bankerproblem_description": "Snatcher is finally going public but there's a big problem to deal with first. The banker who helped us turn dirty money into investments is threatening to tell the press everything.\r\nIf we let that happen, the company is effectively dead in the water.",
    "meta_assets_snatch_bankerproblem_title": "The Banker Problem",
    "meta_assets_concrete_concretematters_description": "To cover up some of our shadier operations, we might use a legitimate business that would turn money from less-than-legal means into clean gains. One such opportunity just presented itself in the construction industry.",
    "meta_assets_antiques_cannon_description": "We have a chance to acquire a cannon from a sixteenth-century Spanish galleon that was lifted from the seabed and polished to its former beauty.",
    "meta_assets_snatch_snatchershares_description": "With the Snatcher stacking up to be a great success, we may benefit from obtaining an even greater share of the company. \r\nThis time we won't need to dig through our own pockets, as long as we're able to help a friend pull a clever insurance fraud.",
    "meta_assets_concrete_cementingthedeal_description": "With the last obstacle out of the way, now is the time to set�up our new construction business.",
    "meta_assets_piano_description": "You never felt the faintest urge to drop by downstairs and play the termite-infested crumbling old piano, but maybe that would change if you had a fantastically expensive one right in your office."
  },
